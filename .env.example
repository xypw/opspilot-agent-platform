# Copy this file to .env and fill in your own key locally. Never commit .env.
ZHIPU_API_KEY=
# 免费 BGE 重排序接口使用单独的 Key；不要把真实 Key 提交到 Git。
SILICONFLOW_API_KEY=
# 当前网络无法直连 Docker Hub 时使用镜像代理；可联网环境可改为 docker.io。
IMAGE_REGISTRY=docker.m.daocloud.io
# 可选：配置后使用 Redis 保存 Agent Checkpoint；Docker 默认端口为 6379。
REDIS_URL=redis://localhost:6379/0
# Compose 对宿主机使用 6380，避免和常见的本机 Redis 6379 冲突；容器内部仍为 6379。
REDIS_HOST_PORT=6380

# PostgreSQL/pgvector：本地 Docker 开发数据库。请仅在本地 .env 填写密码。
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://opspilot:change_this_local_password@localhost:5432/opspilot
# Java 业务服务使用 JDBC URL；本机直跑 Java 时使用该地址，Compose 会覆盖为 postgres 服务名。
BUSINESS_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/opspilot
RETURN_DRAFT_STORE_BACKEND=memory
# memory 用于离线测试；改为 postgres 后，FastAPI 与 Agent 工单工具共同使用 PostgreSQL。
TICKET_REPOSITORY_BACKEND=memory
# 知识库默认留在内存；显式设为 postgres 后，上传和检索均使用 pgvector。
KNOWLEDGE_STORE_BACKEND=memory
# 实验性余弦准入值：低分片段拒答，完整业务标识符精确命中例外；需用正反例校准。
KNOWLEDGE_MIN_COSINE_SIMILARITY=0.60

# 订单查询默认使用离线模拟数据；联调 Java Spring Boot 时显式改为 java。
ORDER_QUERY_BACKEND=memory
ORDER_SERVICE_URL=http://127.0.0.1:8081
